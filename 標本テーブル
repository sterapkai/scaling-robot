function showTable(sample){

let html=

`
<table>

<tr>
<th>ID</th>
<th>性別</th>
<th>年齢</th>
<th>身長</th>
<th>睡眠</th>
<th>労働</th>
</tr>
`;

sample.slice(0,200)
.forEach(p=>{

html+=`

<tr>

<td>${p.ID}</td>

<td>${p.性別}</td>

<td>${p.年齢}</td>

<td>${p.身長_cm}</td>

<td>${p.睡眠時間_h}</td>

<td>${p.労働学業時間_h}</td>

</tr>

`;

});

html+="</table>";

document
.getElementById("tableArea")
.innerHTML=html;

}
